NODE_ENV=development
PORT=3000

# Browser origins allowed to call the API (comma-separated, no wildcard)
CORS_ORIGINS=https://heat-guard-nine.vercel.app,http://localhost:5173

# Either one URL (Render: the "External Database URL") ...
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ... or the five settings below.
DB_HOST=localhost
DB_PORT=5433
DB_USER=heatguard
DB_PASSWORD=heatguard
DB_NAME=heatguard
# true for hosted databases that require SSL (Render, from outside Render)
DB_SSL=false

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 32 bytes, base64: openssl rand -base64 32
# Losing this key makes stored health data unreadable. Keep it in a secrets manager in production.
HEALTH_DATA_ENCRYPTION_KEY=

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHER_POLLING_ENABLED=false

# Used by `npm run seed` (first admin) and `npm run seed:demo` (demo PIN for every demo account)
SEED_ADMIN_ID=A-001
SEED_ADMIN_PIN=246810
SEED_DEMO_PIN=1234

# External HeatGuard AI risk engine (see "heat ai/AI_BACKEND_GUIDE.md").
# The key is sent privately by the engine owner. Server-side only.
ENGINE_BASE_URL=https://heatguard-ai-engine.onrender.com
ENGINE_API_KEY=
ENGINE_TIMEOUT_MS=60000
# Ping the engine every 10 min so Render's free plan doesn't sleep
ENGINE_KEEPALIVE=false
# Set true once the engine accepts the `hood` field (sending it earlier causes 422s)
ENGINE_SUPPORTS_HOOD=false
# Set true once the engine's POST /v1/wbgt (Liljegren) is live; until then our estimator is used
ENGINE_WBGT_ENABLED=false
# Wearable band: the feature itself, and sending band summaries to the engine (when it supports them)
WEARABLES_ENABLED=false
ENGINE_SUPPORTS_WEARABLES=false
